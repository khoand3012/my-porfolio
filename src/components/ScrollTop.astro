<button
  type="button"
  data-scroll-top
  hidden
  aria-label="Back to top"
  class="fixed right-5 bottom-5 z-40 grid size-12 place-items-center rounded-md bg-amber text-amber-ink transition-colors hover:bg-snow"
>
  <svg
    viewBox="0 0 24 24"
    width="22"
    height="22"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 19V5M5 12l7-7 7 7"></path>
  </svg>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-scroll-top]");
  if (button) {
    const update = () => {
      button.hidden = window.scrollY <= 100;
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
    button.addEventListener("click", () => {
      const calm = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      window.scrollTo({ top: 0, behavior: calm ? "auto" : "smooth" });
      // The button hides itself near the top; hand focus to the nav's name
      // link so keyboard users are not dropped onto <body>.
      document
        .querySelector<HTMLElement>('nav a[href="#home"]')
        ?.focus({ preventScroll: true });
    });
  }
</script>
