---
import { profile } from "../data/profile.ts";

const endpoint = import.meta.env.PUBLIC_MESSAGING_API_ENDPOINT;
const tel = profile.phone.replace(/[^\d+]/g, "");

const field =
  "w-full rounded-md border border-line bg-ink px-3.5 py-3 text-snow aria-[invalid=true]:border-amber";
---

<section
  id="contact"
  aria-labelledby="contact-heading"
  class="scroll-mt-6 border-t border-line px-5 py-20 sm:px-8 lg:px-12 lg:py-28"
>
  <div
    class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-14"
  >
    <div class="flex flex-col gap-8">
      <h2
        id="contact-heading"
        class="text-[clamp(2.25rem,6vw,4rem)] leading-none font-bold tracking-[-0.03em]"
      >
        Contact
      </h2>

      <img
        src="/assets/images/me.jpg"
        alt="Portrait of Khoa Nguyen"
        width="576"
        height="1024"
        loading="lazy"
        decoding="async"
        class="aspect-[3/4] w-full max-w-[16rem] rounded-md object-cover object-bottom"
      />

      <p class="flex items-start gap-2.5 leading-snug text-snow">
        <span
          class="mt-[0.45em] size-2 shrink-0 rounded-full bg-live"
          aria-hidden="true"></span>
        <span class="text-balance">{profile.availabilityLong}</span>
      </p>

      <div class="flex flex-col items-start gap-4">
        <a
          href={`mailto:${profile.email}`}
          class="rounded-md bg-amber px-5 py-3 font-bold text-amber-ink transition-colors hover:bg-snow"
        >
          Email me
        </a>
        <p class="text-muted">
          <span class="break-all">{profile.email}</span><br />
          <a
            href={`tel:${tel}`}
            class="underline decoration-line decoration-2 underline-offset-4 transition-colors hover:text-amber hover:decoration-amber"
          >
            {profile.phone}
          </a>
        </p>
        <ul role="list" class="flex flex-wrap gap-x-5 gap-y-2 text-muted">
          {
            profile.links.map((link) => (
              <li>
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline decoration-line decoration-2 underline-offset-4 transition-colors hover:text-amber hover:decoration-amber"
                >
                  {link.label}
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {
      endpoint && (
        <form
          id="contact-form"
          novalidate
          data-email={profile.email}
          class="grid content-start gap-5 sm:grid-cols-2"
        >
          <p class="text-muted sm:col-span-2">
            Or send a message here. Fields marked * are required.
          </p>
          <div class="flex flex-col gap-1.5">
            <label for="contact-name" class="font-bold">
              Name *
            </label>
            <input
              id="contact-name"
              name="name"
              type="text"
              autocomplete="name"
              required
              class={field}
            />
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="contact-email" class="font-bold">
              Email *
            </label>
            <input
              id="contact-email"
              name="email"
              type="email"
              autocomplete="email"
              required
              class={field}
            />
          </div>
          <div class="flex flex-col gap-1.5 sm:col-span-2">
            <label for="contact-telephone" class="font-bold">
              Telephone <span class="font-normal text-muted">(optional)</span>
            </label>
            <input
              id="contact-telephone"
              name="telephone"
              type="tel"
              autocomplete="tel"
              class={field}
            />
          </div>
          <div class="flex flex-col gap-1.5 sm:col-span-2">
            <label for="contact-message" class="font-bold">
              Message *
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="6"
              required
              class={field}
            />
          </div>
          <div class="sm:col-span-2">
            <button
              type="submit"
              class="rounded-md bg-amber px-5 py-3 font-bold text-amber-ink transition-colors hover:bg-snow disabled:cursor-wait disabled:opacity-60 disabled:hover:bg-amber"
            >
              Send message
            </button>
          </div>
        </form>
      )
    }
  </div>
</section>

<script>
  import "../scripts/contactForm.ts";
</script>
