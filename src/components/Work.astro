---
import { work } from "../data/profile.ts";
import WorkCard from "./WorkCard.astro";

const [featured, ...rest] = work;
// The two multi-bullet projects share a row; the three single-bullet ones
// sit three across beneath them.
const span = (i: number) => (i < 2 ? "lg:col-span-3" : "lg:col-span-2");
---

<section
  id="work"
  aria-labelledby="work-heading"
  class="scroll-mt-6 px-5 py-20 sm:px-8 lg:px-12 lg:py-28"
>
  <div class="mx-auto flex max-w-7xl flex-col gap-10 lg:gap-14">
    <h2
      id="work-heading"
      class="text-[clamp(2.25rem,6vw,4rem)] leading-none font-bold tracking-[-0.03em]"
    >
      Work
    </h2>

    {featured && <WorkCard item={featured} featured />}

    <div class="grid gap-x-10 gap-y-12 lg:grid-cols-6">
      {
        rest.map((item, i) => (
          <div class={`flex ${span(i)}`}>
            <WorkCard item={item} />
          </div>
        ))
      }
    </div>
  </div>
</section>
