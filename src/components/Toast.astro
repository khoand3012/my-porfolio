---
// Two live regions that exist from page load, so screen readers announce
// text injected later. Success is polite; errors interrupt (role=alert).
const box =
  "pointer-events-auto max-w-md rounded-md border bg-ink px-4 py-3 leading-snug text-snow shadow-lg empty:hidden";
---

<div
  class="pointer-events-none fixed inset-x-0 bottom-5 z-50 flex flex-col items-center gap-3 px-5"
>
  <div
    data-toast="success"
    role="status"
    aria-live="polite"
    class={`${box} border-live`}
  >
  </div>
  <div data-toast="error" role="alert" class={`${box} border-amber`}></div>
</div>
